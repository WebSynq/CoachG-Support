# ─── COACHG SUPPORT PORTAL — ENV VARS ────────────────────────────────────────
# Copy this file to .env.local for local dev (never commit .env.local to git)
# Set these same vars in Vercel Dashboard → Project → Settings → Environment Variables

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Your Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── GHL Webhook ───────────────────────────────────────────────────────────────
# GHL webhook URL for the support workflow trigger
# In GHL: Automation → Workflows → [Support Ticket Workflow] → Webhook Trigger → copy URL
# ⚠️  This URL MUST stay in env vars. Never put it in any client-side code.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Used by /api/upload to store ticket screenshots in Supabase Storage.
# In Supabase: Project Settings → API → copy Project URL and service_role key.
# Create a Storage bucket (set Public if you want public URLs to resolve directly).
# ⚠️  SUPABASE_SERVICE_KEY MUST stay in env vars. Never put it in any client-side code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=Support Bucket

# ── Security ──────────────────────────────────────────────────────────────────
# Your deployed Vercel URL — used to validate request origin
# Format: https://your-project-name.vercel.app  (no trailing slash)
# Update this after first deploy with your actual Vercel domain
ALLOWED_ORIGIN=https://your-project-name.vercel.app

# ── Optional: Custom Domain ───────────────────────────────────────────────────
# If you add a custom domain in Vercel (e.g., support.coachghuddle.com),
# update ALLOWED_ORIGIN to match: https://support.coachghuddle.com
